# Copy this file to .env and fill in your key from console.anthropic.com (API Keys).
# Without a key the server runs AI members in dry-run mode.
ANTHROPIC_API_KEY=
# Optional: which Claude model the agents use.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: port, and the address to listen on (0.0.0.0 to accept other machines; accounts must be on).
# PORT=3000
# HOST=127.0.0.1

# Accounts are on by default: the first sign-up creates a workspace, later people join with invite links.
# LOCAL_MODE=1 turns sign-in off and keeps one workspace on this machine (development and tests).
# LOCAL_MODE=1
# Anyone may create their own workspace (and spend AI requests) when this is 1.
# OPEN_SIGNUP=1
# Claude requests per workspace per UTC day. Dry runs are not counted.
# AI_DAILY_LIMIT=200
# Public address used in invite links. An https:// address also marks the session cookie Secure.
# PUBLIC_URL=https://kantor.example.com
# Behind a reverse proxy (nginx, Caddy, a hosting platform): trust its X-Forwarded-For and X-Forwarded-Proto.
# TRUST_PROXY=1
